{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backlog Panda",
  "version": "0.2.0",
  "identifier": "fr.backlogpanda.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Backlog Panda",
        "width": 1320,
        "height": 840,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#080b17"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://images.igdb.com data:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
